    {
      "parameters": {
        "method": "POST",
        "url": "https://api.vapi.ai/call/phone",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_VAPI_API_KEY"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"assistantId\": \"YOUR_VAPI_ASSISTANT_ID\",\n  \"phoneNumberId\": \"YOUR_VAPI_PHONE_NUMBER_ID\",\n  \"customer\": {\n    \"number\": \"{{ $json.phone }}\"\n  },\n  \"metadata\": {\n    \"row_number\": \"{{ $json.row_number }}\"\n  },\n  \"assistantOverrides\": {\n    \"serverUrl\": \"{{ $execution.resumeUrl }}\",\n    \"serverMessages\": [\n      \"end-of-call-report\"\n    ],\n    \"variableValues\": {\n      \"name\": \"{{ $json.name }}\",\n      \"email\": \"{{ $json.email }}\",\n      \"phone\": \"{{ $json.phone }}\",\n      \"mcdot\": \"{{ $json.mcdot }}\",\n      \"row_number\": \"{{ $json.row_number }}\"\n    }\n  }\n}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        }
      },
      "id": "ddf4de31-a655-4774-a0d5-63cf5468174a",
      "name": "HTTP Request - VAPI Call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        304,
        -112
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "YOUR_VAPI_CREDENTIAL_ID",
          "name": "VAPI Header Auth"
        }
      }
