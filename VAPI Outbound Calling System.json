    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst pendingLeads = items\n  .filter(item => {\n    const status = (item.json['Status'] || item.json['status'] || '').toString().toLowerCase().trim();\n    return status === 'pending';\n  })\n  .map(item => ({\n    json: {\n      row_number: item.json['row_number'],\n      name: item.json['Name'] || '',\n      email: item.json['Email'] || '',\n      phone: item.json['Phone Number'] || '',\n      mcdot: item.json['MC/DOT'] || '',\n      status: item.json['Status'] || item.json['status'] || ''\n    }\n  }));\n\nif (pendingLeads.length === 0) {\n  return [{ json: { noPendingLeads: true, message: 'No pending leads found.' } }];\n}\n\nreturn pendingLeads;"
      },
      "id": "0ef5dd09-1915-4eb5-8b18-8be4185cad0c",
