    {
      "parameters": {
        "jsCode": "const msg = ($input.item.json.body || $input.item.json).message || {};\nconst oldData = $('Split In Batches').item.json;\n\n// Status & Summary Fixes\nconst finalStatus = msg.endedReason || msg.call?.status || 'Completed';\nlet finalSummary = msg.summary || 'Call too short or Voicemail.';\nlet isHotLead = 'No';\nlet equipmentType = '';\n\n// VAPI ke naye format se data nikalna\nconst outputs = msg.artifact?.structuredOutputs || {};\nfor (const key in outputs) {\n    const field = outputs[key];\n    if (field.name === 'hot_lead' || field.name === 'hot_leads') isHotLead = field.result || isHotLead;\n    if (field.name === 'call_summary') finalSummary = field.result || finalSummary;\n    if (field.name === 'equipment_type') equipmentType = field.result || equipmentType;\n}\n\nreturn [{\n  json: {\n    row_id: oldData.row_number || msg.call?.metadata?.row_number,\n    Status: 'Called - ' + finalStatus,\n    Call_summary: finalSummary,\n    Hot_Leads: isHotLead,\n    Truck_Type: equipmentType\n  }\n}];"
      },
